#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "Usage: $0 [-r] [DIRECTORY]"
    echo "  -r          Select a region interactively (scrot -s)"
    echo "  DIRECTORY   Target folder (defaults to ~/Downloads)"
    exit 1
}

# Default values
REGION_FLAG=""
TARGET_DIR=""

# Parse options
while getopts ":r" opt; do
    case "${opt}" in
        r)
            REGION_FLAG="-s"
            ;;
        \?)
            echo "Error: Invalid option -${OPTARG}" >&2
            usage
            ;;
    esac
done
shift $((OPTIND - 1))

# Set target directory (defaults to ~/Downloads if none given)
TARGET_DIR="${1:-$HOME/Downloads}"

# Ensure directory exists
mkdir -p "$TARGET_DIR"

# Generate filename timestamp
TIMESTAMP=$(date +'%Y-%m-%d-%H%M%S')
FILEPATH="${TARGET_DIR}/${TIMESTAMP}.png"

# Execute scrot and pipe to clipboard
scrot ${REGION_FLAG} "$FILEPATH" \
  -e 'xclip -selection clipboard -t image/png -i $f'

echo "Screenshot saved to $FILEPATH and copied to clipboard."
